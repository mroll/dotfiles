  if (localStorage.theme === 'light') {
    //localStorage.setItem('theme', 'dark');
    localStorage.theme = 'dark'
  } else {
    //localStorage.setItem('theme', 'light');
    localStorage.theme = 'light'
  }
  location.reload();
  return false;
}
